# Route Session Service Configuration

# Application
APP_NAME=Route Session Service
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgres://postgres:password@localhost:5436/music_social_routes?sslmode=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=redpanda:9092
KAFKA_EVENTS_TOPIC=route-session-events
KAFKA_SYNC_TOPIC=route-session-sync

# Routes Service
ROUTES_SERVICE_URL=http://routes-service:8080

# Server
HOST=0.0.0.0
PORT=8080

